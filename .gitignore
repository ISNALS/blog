# 依赖与构建产物
node_modules/
dist/
.astro/
.vercel/
.netlify/

# 本地调试产物（截图、日志、探针）
shots/
*.log

# 环境变量（本项目不需要，但别让谁手滑把 token 写进来）
.env
.env.*
!.env.example

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 交付预览图（本地产物，会让仓库随界面改动不断产生二进制 diff）
preview.png

# 配置预检自测的崩溃备份（正常跑完会被清掉，留着说明上次被强杀）
.selftest-backup/

# 用 git commit -F 传消息时的临时文件（别让它进仓库）
commit-msg.txt
*.tmp.txt
