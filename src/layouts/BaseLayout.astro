---
/**
 * 全站外壳：<head> SEO / 字体 / 导航 / 页脚 / 页面转场 / 动效引擎。
 *
 * 页面转场走 Astro 的 ClientRouter（View Transitions）：
 * 换页时旧页模糊放大淡出、新页从模糊缩小淡入（CSS 在 global.css 的
 * ::view-transition-* 里统一管），因此"文章之间"的过渡与"文章内文字之间"的
 * 过渡是同一套语言，不会一半生硬一半花哨。
 */
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV, GITHUB } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** og 类型：文章页用 article */
  type?: 'website' | 'article';
  image?: string;
  /** 首页不需要页头大留白，文章页需要 */
  compact?: boolean;
}

const { title, description = SITE.description, type = 'website', image, compact = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = NAV.map((n) => ({ ...n, href: `${base}${n.href}` }));
const here = Astro.url.pathname.replace(base, '') || '/';
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site ?? SITE.url).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${base}/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">跳到正文</a>

    <header class="site-head" transition:persist>
      <div class="shell head-inner">
        <a class="brand" href={`${base}/`} aria-label={SITE.title}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">{SITE.title}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={here === n.href.replace(base, '') || (n.href.endsWith('/') && here === '/') ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <a class="nav-admin" href={`${base}/admin`} title="写文章">写</a>
        </nav>
      </div>
    </header>

    <main id="main" class:list={['shell', compact && 'is-compact']}>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="shell foot-inner">
        <p class="mono">© {new Date().getFullYear()} {SITE.author} · {SITE.title}</p>
        <p class="mono">
          <a href={`${base}/rss.xml`}>RSS</a>
          <span aria-hidden="true"> · </span>
          {/* 仓库地址从 consts 读：写死用户名会让部署前改配置时漏掉这一处
              （终检发现页脚曾硬编码 'LHX'/'blog'） */}
          <a href={`https://github.com/${GITHUB.user}/${GITHUB.repo}`}>GitHub</a>
        </p>
      </div>
    </footer>

    <script>
      import { initMotion } from '../scripts/motion';
      import { hydrateViews } from '../scripts/views';

      // ClientRouter 换页后要重新初始化（两个函数都幂等，重复调用安全）
      const boot = () => {
        initMotion(document);
        hydrateViews(document);
      };
      boot();
      document.addEventListener('astro:page-load', boot);
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      .site-head {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(14px) saturate(1.2);
        background: color-mix(in oklab, var(--bg) 72%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 4.25rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--serif);
        font-size: var(--step-1);
        letter-spacing: -0.01em;
      }
      .brand-mark {
        width: 0.6rem;
        height: 0.6rem;
        background: var(--accent);
        border-radius: 50%;
        transition: transform var(--dur-2) var(--ease-out);
      }
      .brand:hover .brand-mark {
        transform: scale(1.55);
      }
      .nav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 2.4vw, 2rem);
      }
      /* 窄屏收紧：390px 视口下四个入口 + 品牌名必须同行放下，
         否则会出现"看起来被裁掉"的错觉（实测截图里就是这个观感） */
      @media (max-width: 26rem) {
        .nav {
          gap: 0.75rem;
        }
        .nav a {
          font-size: 0.76rem;
          letter-spacing: 0.02em;
        }
        .brand {
          font-size: 1.05rem;
          gap: 0.45rem;
        }
      }
      .nav a {
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        color: var(--ink-2);
        position: relative;
        transition: color var(--dur-1) var(--ease-out);
      }
      .nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.35rem;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform var(--dur-2) var(--ease-out);
      }
      .nav a:hover,
      .nav a[aria-current='page'] {
        color: var(--ink);
      }
      .nav a:hover::after,
      .nav a[aria-current='page']::after {
        transform: scaleX(1);
      }
      .nav-admin {
        font-family: var(--mono);
        text-transform: uppercase;
      }

      main {
        padding-top: clamp(3rem, 9vw, 8rem);
        padding-bottom: clamp(4rem, 10vw, 9rem);
        min-height: 60vh;
      }
      main.is-compact {
        padding-top: clamp(2rem, 5vw, 4rem);
      }

      .site-foot {
        border-top: 1px solid var(--line);
        padding-block: 2.5rem;
      }
      .foot-inner {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .foot-inner a:hover {
        color: var(--ink);
      }
      .mono {
        margin: 0;
      }

      /* 阅读量：原生实现，不用 React 岛（文章页因此零框架依赖） */
      [data-views] {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--ink-2);
        font-variant-numeric: tabular-nums;
        transition: color 400ms var(--ease-out);
      }
      [data-views][data-fresh='true'] {
        color: var(--accent);
      }
      .views-row {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin: 0;
      }
      .views-row::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        opacity: 0.85;
      }
    </style>
  </body>
</html>
