---
/**
 * 全站外壳：<head> SEO / 字体 / 导航 / 页脚 / 页面转场 / 动效引擎。
 *
 * 页面转场走 Astro 的 ClientRouter（View Transitions）：
 * 换页时旧页模糊放大淡出、新页从模糊缩小淡入（CSS 在 global.css 的
 * ::view-transition-* 里统一管），因此"文章之间"的过渡与"文章内文字之间"的
 * 过渡是同一套语言，不会一半生硬一半花哨。
 */
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV, GITHUB } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** og 类型：文章页用 article */
  type?: 'website' | 'article';
  image?: string;
  /** 首页不需要页头大留白，文章页需要 */
  compact?: boolean;
  /**
   * 是否允许搜索引擎收录。默认允许。
   *
   * 用途是给 `/admin` 这类"只给自己用的页面"关掉索引。要注意它**不是访问控制**：
   * 面板的安全性来自 GitHub 的 token 校验（没 token 写不进去 401），
   * noindex 只是不让它出现在搜索结果里——搜到一个 token 输入框本身就很怪。
   */
  indexable?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image,
  compact = false,
  indexable = true,
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = NAV.map((n) => ({ ...n, href: `${base}${n.href}` }));
/**
 * 当前路径与导航项的比对**必须两侧都归一化**（去掉结尾斜杠）。
 * 踩过的坑：`here` 是 `/archive`（Astro 的 pathname 无尾斜杠），而 NAV 里写的是
 * `/archive/`（有尾斜杠），直接相等判断永远为 false —— 于是归档页和关于页的
 * 首屏高亮**本来就是空的**，再叠加 transition:persist 的 DOM 复用，
 * 就成了用户看到的"点哪儿都停在首页"。
 */
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname.replace(base, '') || '/');
const isCurrent = (href: string) => norm(href.replace(base, '')) === here;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* 不给索引的页面（后台）明确声明；同时关掉 follow，避免顺着链接爬到别处 */}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site ?? SITE.url).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${base}/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">跳到正文</a>

    <header class="site-head" transition:persist>
      <div class="shell head-inner">
        <a class="brand" href={`${base}/`} aria-label={SITE.title}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">{SITE.title}</span>
        </a>
        {/* data-main-nav 是给 src/scripts/nav.ts 定位用的——文章页的目录也是 nav[aria-label]，
            靠 aria-label 选元素会误伤它 */}
        <nav class="nav" aria-label="主导航" data-main-nav>
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          {/* 写作面板的入口刻意不放在导航里：它是只给站主用的页面，
              访客没有 token 也写不了（GitHub 会 401），但没必要把它摆在最显眼处。
              需要时直接访问 /admin 即可（地址见 README）。 */}
        </nav>
        {/*
          服务器渲染的 aria-current 只在**首屏**正确。头部带 transition:persist，
          换页时 DOM 被复用、不会重新渲染，所以必须靠脚本在 astro:page-load 时重算，
          否则下划线会永远停在首页（见 src/scripts/nav.ts 的长注释）。
        */}
        <script>
          import { updateNavCurrent } from '../scripts/nav';
          updateNavCurrent(document);
          document.addEventListener('astro:page-load', () => updateNavCurrent(document));
        </script>
      </div>
    </header>

    <main id="main" class:list={['shell', compact && 'is-compact']}>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="shell foot-inner">
        <p class="mono">© {new Date().getFullYear()} {SITE.author} · {SITE.title}</p>
        <p class="mono">
          <a href={`${base}/rss.xml`}>RSS</a>
          <span aria-hidden="true"> · </span>
          {/* 仓库地址从 consts 读：写死用户名会让部署前改配置时漏掉这一处
              （终检发现页脚曾硬编码 'LHX'/'blog'） */}
          <a href={`https://github.com/${GITHUB.user}/${GITHUB.repo}`}>GitHub</a>
        </p>
      </div>
    </footer>

    <script>
      import { initMotion } from '../scripts/motion';
      import { hydrateViews } from '../scripts/views';

      // ClientRouter 换页后要重新初始化（两个函数都幂等，重复调用安全）
      const boot = () => {
        initMotion(document);
        hydrateViews(document);
      };
      boot();
      document.addEventListener('astro:page-load', boot);
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      .site-head {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(14px) saturate(1.2);
        background: color-mix(in oklab, var(--bg) 72%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 4.25rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--serif);
        font-size: var(--step-1);
        letter-spacing: -0.01em;
      }
      .brand-mark {
        width: 0.6rem;
        height: 0.6rem;
        background: var(--accent);
        border-radius: 50%;
        transition: transform var(--dur-2) var(--ease-out);
      }
      .brand:hover .brand-mark {
        transform: scale(1.55);
      }
      .nav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 2.4vw, 2rem);
      }
      /* 窄屏收紧：390px 视口下四个入口 + 品牌名必须同行放下，
         否则会出现"看起来被裁掉"的错觉（实测截图里就是这个观感） */
      @media (max-width: 26rem) {
        .nav {
          gap: 0.75rem;
        }
        .nav a {
          font-size: 0.76rem;
          letter-spacing: 0.02em;
        }
        .brand {
          font-size: 1.05rem;
          gap: 0.45rem;
        }
      }
      .nav a {
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        color: var(--ink-2);
        position: relative;
        transition: color var(--dur-1) var(--ease-out);
      }
      .nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.35rem;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform var(--dur-2) var(--ease-out);
      }
      .nav a:hover,
      .nav a[aria-current='page'] {
        color: var(--ink);
      }
      .nav a:hover::after,
      .nav a[aria-current='page']::after {
        transform: scaleX(1);
      }

      main {
        padding-top: clamp(3rem, 9vw, 8rem);
        padding-bottom: clamp(4rem, 10vw, 9rem);
        min-height: 60vh;
      }
      main.is-compact {
        padding-top: clamp(2rem, 5vw, 4rem);
      }

      .site-foot {
        border-top: 1px solid var(--line);
        padding-block: 2.5rem;
      }
      .foot-inner {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .foot-inner a:hover {
        color: var(--ink);
      }
      .mono {
        margin: 0;
      }

      /* 阅读量：原生实现，不用 React 岛（文章页因此零框架依赖） */
      [data-views] {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--ink-2);
        font-variant-numeric: tabular-nums;
        transition: color 400ms var(--ease-out);
      }
      [data-views][data-fresh='true'] {
        color: var(--accent);
      }
      .views-row {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin: 0;
      }
      .views-row::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        opacity: 0.85;
      }
    </style>
  </body>
</html>
