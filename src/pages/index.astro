---
/**
 * 首页：超大字刊头 + 离格卡片栅格。
 *
 * 结构（能量曲线）：刊头（一击）→ 序号导语（呼吸）→ 置顶大卡（一击）→ 两列错位卡（连绵）。
 * 所有揭示都走 [data-reveal] / [data-split] / [data-group] 三个动效基元，
 * 因此首屏与列表用的是同一组时值。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const all = (await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const total = all.length;
const tagsTop = [...new Set(all.flatMap((p) => p.data.tags))].slice(0, 6);
---

<BaseLayout compact>
  <section class="hero">
    <p class="hero-kicker mono" data-reveal data-delay-fixed style="--delay:60ms">
      {SITE.tagline}
    </p>

    <h1 class="hero-title" data-split>{SITE.title}</h1>

    <div class="hero-foot">
      {/*
        这句刊头文案改读 SITE.description，不再硬编码。
        理由：它和 SEO / OG / RSS 的站点描述本来就是同一句话，之前两处各写一遍，
        改文案时必然漏一处（这次就漏了）。现在只有一个来源。
      */}
      <p class="hero-lead" data-reveal style="--rise:24px">
        <span class="offset-right">{SITE.description}</span>
      </p>

      <dl class="hero-stats mono" data-reveal data-delay-fixed style="--delay:320ms">
        <div>
          <dt>文章</dt>
          <dd>{String(total).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>标签</dt>
          <dd>{String(tagsTop.length).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>更新</dt>
          <dd>{all[0] ? all[0].data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.') : '—'}</dd>
        </div>
      </dl>
    </div>
  </section>

  {/*
    网络探针：访问人数与访客来自哪些国家。
    纯前端实现（GitHub Pages 没有服务端，拿不到 IP），细节与取舍见 src/scripts/probe.ts。
    刻意做成一条细窄的信息条、而不是一块卡片 —— 它是元信息，不该和文章争视觉重量。
    初始 HTML 里所有数字都是占位符，脚本填充；脚本失败时这里只显示"—"和一行说明，
    不会留下空框。
  */}
  <section class="probe" data-reveal aria-labelledby="probe-title">
    <p class="probe-head mono">
      <span class="probe-dot" aria-hidden="true"></span>
      <span id="probe-title">网络探针</span>
    </p>
    <div class="probe-body" data-probe>
      <p class="probe-total mono">
        <span data-probe-total>—</span>
        <span class="probe-unit">次访问</span>
      </p>
      <ul class="probe-countries mono" data-probe-countries></ul>
      <p class="probe-state mono" data-probe-state></p>
    </div>
  </section>

  <section class="feed" aria-labelledby="feed-title">
    <header class="feed-head">
      <h2 id="feed-title" class="feed-title" data-reveal data-delay-fixed style="--delay:0ms">
        最新<span class="accent">/</span>全部
      </h2>
      <a class="feed-more mono" href={`${base}/archive`} data-reveal data-delay-fixed style="--delay:120ms">
        归档 →
      </a>
    </header>

    {
      total === 0 ? (
        <div class="empty" data-reveal>
          <p class="empty-title">还没有文章。</p>
          <p class="empty-hint">
            去 <a href={`${base}/admin`}>写文章</a> 发布第一篇 —— 支持图片、支持草稿。
          </p>
        </div>
      ) : (
        <div class="grid" data-group>
          {all.map((post, i) => (
            <PostCard post={post} index={i} base={base} feature={post.data.featured} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  import { initProbe } from '../scripts/probe';
  // 换页后首页可能被重新挂载，所以和动效引擎一样在 astro:page-load 时再跑一次；
  // initProbe 用 dataset 做了幂等保护，重复调用安全。
  const boot = () => initProbe(document);
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .hero {
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }

  .hero-kicker {
    margin: 0 0 clamp(1.5rem, 4vw, 3rem);
    max-width: 30ch;
  }

  .hero-title {
    font-size: var(--step-4);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0 0 clamp(2rem, 6vw, 4.5rem);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero-lead {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
    max-width: 34ch;
  }

  .hero-stats {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
  }
  .hero-stats div {
    display: grid;
    gap: 0.35rem;
  }
  .hero-stats dt {
    font-size: 0.68rem;
    color: var(--ink-3);
  }
  .hero-stats dd {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* ── 网络探针 ─────────────────────────────────────────────────────────────
     刻意做成一条细窄的信息条而非卡片：它是元信息，不该和文章争视觉重量。
     左侧是标题，右侧是总数 + 各国列表；窄屏折成上下两行。
     ---------------------------------------------------------------------- */
  .probe {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem 2rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 0.95rem 0;
    margin-bottom: clamp(3rem, 8vw, 6rem);
    font-size: 0.72rem;
    line-height: 1.7;
  }
  @media (min-width: 48rem) {
    .probe {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .probe-head {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .probe-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    /* 极慢的呼吸：暗示"在线"，但每秒都在动会变成干扰 */
    animation: probe-pulse 3.2s var(--ease-out) infinite;
  }
  @keyframes probe-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }

  .probe-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    min-width: 0;
  }

  .probe-total {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .probe-total > span:first-child {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1;
  }
  .probe-unit {
    color: var(--ink-3);
    font-size: 0.68rem;
  }

  .probe-countries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    min-width: 0;
  }
  .probe-countries li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .probe-flag {
    font-size: 0.95rem;
    line-height: 1;
  }
  .probe-name {
    color: var(--ink-2);
  }
  .probe-n {
    color: var(--ink-3);
  }
  .probe-n::before {
    content: '·';
    margin-right: 0.35rem;
    color: var(--line-2);
  }

  .probe-state {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.68rem;
  }
  .probe-state:empty {
    display: none;
  }

  .feed-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .feed-title {
    font-size: var(--step-2);
    margin: 0;
  }
  .feed-title .accent {
    color: var(--accent);
  }
  .feed-more {
    color: var(--ink-3);
    transition: color var(--dur-1) var(--ease-out);
  }
  .feed-more:hover {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3.5rem);
  }
  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .empty {
    border: 1px dashed var(--line-2);
    padding: clamp(2rem, 6vw, 4rem);
    text-align: center;
  }
  .empty-title {
    font-family: var(--serif);
    font-size: var(--step-2);
    margin: 0 0 0.6rem;
  }
  .empty-hint {
    margin: 0;
    color: var(--ink-2);
  }
  .empty-hint a {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }
</style>
