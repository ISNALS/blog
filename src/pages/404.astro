---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="找不到这一页" compact>
  <section class="nf">
    <p class="mono" data-reveal>404</p>
    <h1 class="nf-title" data-split>这一页不在了</h1>
    <p class="nf-lead" data-reveal>
      链接可能过期了，也可能是文章改名了。回首页看看别的。
    </p>
    <a class="nf-back" href={`${base}/`} data-reveal>← 回首页</a>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }
  .nf-title {
    font-size: var(--step-3);
    margin: 0;
  }
  .nf-lead {
    color: var(--ink-2);
    margin: 0;
  }
  .nf-back {
    justify-self: start;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .nf-back:hover {
    transform: translateX(-4px);
  }
</style>
