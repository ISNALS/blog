{
  "name": "blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "个人博客：Astro 静态站 + GitHub Pages 托管 + 浏览器直连 GitHub 的写作面板",
  "scripts": {
    "dev": "astro dev --port 4321 --host 127.0.0.1",
    "start": "astro dev --port 4321 --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "serve:dist": "node scripts/serve-dist.mjs 4500",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:config": "node scripts/check-config.mjs",
    "selftest:config": "node scripts/selftest-config-check.mts",
    "test": "node scripts/test-post-format.mts && node scripts/test-github-client.mts && node scripts/test-saver.mts && node scripts/test-find-chrome.mjs && npm run selftest:config",
    "test:nav": "node scripts/test-nav-with-server.mjs",
    "test:probe": "node scripts/test-probe-with-server.mjs",
    "test:home": "node scripts/test-home-with-server.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:links && npm run test:nav && npm run test:probe && npm run test:home",
    "predeploy": "npm run verify && npm run check:config",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^5.18.2",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10"
  },
  "engines": {
    "node": ">=23.6"
  }
}
